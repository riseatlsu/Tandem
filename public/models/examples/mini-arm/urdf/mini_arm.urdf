<?xml version="1.0"?>
<!-- Tandem example: a 6-axis arm. Meshes are STL in meters, in each link's frame. -->
<robot name="Tandem Mini 6">
  <link name="base_link"><visual><geometry><mesh filename="package://mini-arm/meshes/base_link.stl"/></geometry></visual></link>
  <link name="link1"><visual><geometry><mesh filename="package://mini-arm/meshes/link1.stl"/></geometry></visual></link>
  <link name="link2"><visual><geometry><mesh filename="package://mini-arm/meshes/link2.stl"/></geometry></visual></link>
  <link name="link3"><visual><geometry><mesh filename="package://mini-arm/meshes/link3.stl"/></geometry></visual></link>
  <link name="link4"><visual><geometry><mesh filename="package://mini-arm/meshes/link4.stl"/></geometry></visual></link>
  <link name="link5"><visual><geometry><mesh filename="package://mini-arm/meshes/link5.stl"/></geometry></visual></link>
  <link name="link6"><visual><geometry><mesh filename="package://mini-arm/meshes/link6.stl"/></geometry></visual></link>
  <link name="tool0"/>
  <joint name="joint1" type="revolute"><parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.16" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" velocity="1.6" effort="50"/></joint>
  <joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" velocity="1.6" effort="50"/></joint>
  <joint name="joint3" type="revolute"><parent link="link2"/><child link="link3"/><origin xyz="0 0 0.35" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-2.8" upper="2.8" velocity="1.6" effort="50"/></joint>
  <joint name="joint4" type="revolute"><parent link="link3"/><child link="link4"/><origin xyz="0 0 0.3" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" velocity="1.6" effort="50"/></joint>
  <joint name="joint5" type="revolute"><parent link="link4"/><child link="link5"/><origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-3.05" upper="3.05" velocity="1.6" effort="50"/></joint>
  <joint name="joint6" type="revolute"><parent link="link5"/><child link="link6"/><origin xyz="0 0 0.08" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-6.2832" upper="6.2832" velocity="1.6" effort="50"/></joint>
  <joint name="flange" type="fixed"><parent link="link6"/><child link="tool0"/><origin xyz="0 0 0.03"/></joint>
</robot>
