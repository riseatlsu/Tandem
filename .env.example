# Copy to .env.local (or set as GitHub Actions *variables* for the Pages build). None of these are secrets:
# the OpenAI key lives only in Firebase Secret Manager (OPENAI_API_KEY) and is used by the llmProxy function.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# https://<region>-<project>.cloudfunctions.net/llmProxy
VITE_LLM_PROXY_URL=
# https://<region>-<project>.cloudfunctions.net  (redeemCode lives here)
VITE_FUNCTIONS_URL=
# Comma-separated models offered in demo mode (must match config/llm.demoModels on the server)
VITE_DEMO_MODELS=gpt-5-mini,gpt-5-nano,gpt-4.1-mini
# Local development against emulators
# VITE_USE_EMULATORS=true
